# Порт и хост API (в проде отдаёт и собранный веб-клиент)
PORT=8080
HOST=0.0.0.0

# Секрет для JWT. Обязательно поменяйте в проде (любая длинная случайная строка)
JWT_SECRET=change-me-please-use-a-long-random-string

# Каталог с базой данных (SQLite) и временными файлами. Держите его на локальном диске сервера.
DATA_DIR=./data

# Каталог с медиафайлами (треки, видео, обложки, канвасы, аватары). По умолчанию DATA_DIR/media.
# Может быть сетевым диском (rclone mount / SSHFS / NFS / SMB), например смонтированным ПК:
# MEDIA_DIR=/mnt/pc-storage/avrmusic
MEDIA_DIR=

# Импорт по ссылке (YouTube, SoundCloud, Bandcamp и т.д.) через yt-dlp. Путь к бинарнику, если не в PATH.
YTDLP_PATH=yt-dlp
# ffmpeg нужен для перекодирования аудио из видео и для mp4-видео; без него аудио сохраняется как есть.
FFMPEG_PATH=ffmpeg

# Сервер синхронизированных текстов (открытый API, можно поднять свой)
LRCLIB_URL=https://lrclib.net

# Android TWA (Digital Asset Links): package name и SHA-256 отпечаток(и) ключа подписи через запятую
ANDROID_PACKAGE=app.avrmusic.twa
ANDROID_SHA256=

# Необязательно: папка с уже существующей музыкальной коллекцией.
# `pnpm scan` или кнопка «Сканировать» в админке импортирует её без копирования файлов.
MUSIC_DIR=

# Разрешить регистрацию новых пользователей (первый зарегистрированный — админ)
ALLOW_REGISTRATION=true
# Код приглашения для регистрации (сервис «для себя и друзей»): пусто — без кода
INVITE_CODE=

# Глобальный каталог (метаданные исполнителей/альбомов/треков из Deezer public API, без ключа)
CATALOG_ENABLED=true
DEEZER_API=https://api.deezer.com
# Кто может запрашивать добавление треков из каталога в библиотеку: user | admin | off
ACQUIRE_ROLE=user
# Источники аудио для треков из каталога, по убыванию приоритета (через запятую):
#   youtube    — YouTube / YouTube Music через yt-dlp (максимальный охват, Opus/AAC до ~160–256 kbps)
#   audius     — Audius, открытая платформа независимых артистов и ремиксов (MP3 320 или оригинал, если разрешено)
#   archive    — Internet Archive: нетлейблы, Live Music Archive, public domain (часто FLAC)
#   soundcloud — SoundCloud через yt-dlp (MP3 128 / Opus)
#   jamendo    — Jamendo, Creative Commons (нужен бесплатный JAMENDO_CLIENT_ID)
ACQUIRE_SOURCES=youtube,audius,archive,soundcloud,jamendo
JAMENDO_CLIENT_ID=
AUDIUS_APP_NAME=AVRmusic

# Разрешить гостям (без входа) просматривать каталог и слушать музыку.
# Скачивание, лайки и плейлисты всегда требуют входа.
PUBLIC_LIBRARY=false

# Максимальный размер одного загружаемого файла, МБ
MAX_UPLOAD_MB=512

# Публичный URL (используется в ссылках, manifest, assetlinks). Например https://music.example.com
PUBLIC_URL=http://localhost:8080

# Путь к собранному веб-клиенту (по умолчанию ../web/dist)
WEB_DIST=
