# ---- AVRmusic production (.env next to docker-compose.prod.yml) ----
DOMAIN=music.avthsr.space
# caddy — свой HTTPS-прокси на 80/443 (порты должны быть свободны); nginx — использовать nginx сервера
PROXY=caddy
COMPOSE_PROFILES=caddy
# порт приложения на 127.0.0.1 (для режима nginx)
APP_PORT=8080
# e-mail для Let's Encrypt (режим nginx), можно оставить пустым
LE_EMAIL=
# любая длинная случайная строка: openssl rand -hex 32
JWT_SECRET=
# регистрация только по одноразовым кодам, которые администратор создаёт в админке (Пользователи → Приглашения)
ALLOW_REGISTRATION=true
# гости без входа не видят библиотеку
PUBLIC_LIBRARY=false
MAX_UPLOAD_MB=2048
# каталог и автоподбор
CATALOG_ENABLED=true
ACQUIRE_ROLE=user
ACQUIRE_SOURCES=youtube,audius,archive,soundcloud,jamendo
JAMENDO_CLIENT_ID=
AUDIUS_APP_NAME=AVRmusic
# канвасы: автоматически резать отрезок официального клипа (YouTube) для треков из каталога
CANVAS_AUTO=true
CANVAS_SECONDS=9
# где лежат данные на сервере (медиа можно указать на смонтированный диск вашего ПК)
DATA_PATH=/srv/avrmusic/data
MEDIA_PATH=/srv/avrmusic/media
MUSIC_PATH=/srv/avrmusic/music
